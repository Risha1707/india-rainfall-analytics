{
  "python.defaultInterpreterPath": "python",
  "python.terminal.activateEnvironment": true,
  "jupyter.interactiveWindow.textEditor.executeSelection": true,
  "files.exclude": {
    "**/.git": false,
    "**/.svn": true,
    "**/.hg": true,
    "**/CVS": true,
    "**/.DS_Store": true,
    "**/Thumbs.db": true,
    "**/__pycache__": false
  },
  "editor.formatOnSave": true
}
